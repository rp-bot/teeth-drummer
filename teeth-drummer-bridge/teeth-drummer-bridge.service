[Unit]
Description=Teeth Drummer MIDI Bridge Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=YOUR_USERNAME
Group=dialout
WorkingDirectory=/path/to/teeth-drummer-bridge
ExecStart=/usr/bin/python3 -m teeth_drummer_bridge --serial-port /dev/ttyUSB0 --daemon
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment=PYTHONPATH=/path/to/teeth-drummer-bridge/src

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/tmp /dev/ttyUSB0

[Install]
WantedBy=multi-user.target
